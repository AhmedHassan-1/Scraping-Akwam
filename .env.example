# Server
PORT=5000
CORS_ORIGIN=http://localhost:5000,http://127.0.0.1:5000

# Akwam Base Target Site
AKWAM_BASE_URL=https://ak.sv

# Redis (Local Docker or Upstash)
# For local Redis:
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_TLS=false

# For Upstash / Managed Redis (uncomment and fill):
# REDIS_URL=rediss://default:<password>@<host>:<port>

# Queue tuning
SCRAPE_REQUESTS_PER_SECOND=1
QUEUE_MAX_CONCURRENT_JOBS=1
QUEUE_DEFAULT_PRIORITY=10
QUEUE_ADMIN_PRIORITY=1000000

# Per-user API rate limiting
RATE_LIMIT_PER_USER=30
RATE_LIMIT_JOBS_PER_USER=30
RATE_LIMIT_IMAGES_PER_USER=150
RATE_LIMIT_WINDOW_SEC=60

# Admin bypass cookie (generate a secure random value)
QUEUE_BYPASS_COOKIE_NAME=access_queue
QUEUE_BYPASS_COOKIE_VALUE=your-secure-random-bypass-token-here

# Swagger Documentation Basic Authentication
SWAGGER_USER=admin
SWAGGER_PASSWORD=admin123
